  },
  "dependencies": {
    "@rnx-kit/tools-node": "workspace:^",
    "@rnx-kit/tools-packages": "workspace:^",
    "@rnx-kit/types-bundle-config": "workspace:^",
    "@rnx-kit/types-kit-config": "workspace:^",
    "@rnx-kit/types-node": "workspace:^",
    "lodash.merge": "^4.6.2"
  },
  "devDependencies": {
    "@rnx-kit/scripts": "workspace:*",
    "@rnx-kit/tsconfig": "workspace:*",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "catalog:",
    "metro": "^0.84.0"
  },
  "engines": {
    "node": ">=20.18"
  }
}
