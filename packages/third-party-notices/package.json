{
  "name": "@rnx-kit/third-party-notices",
  "version": "3.0.4",
  "description": "Library and tool to build a third party notices file based on a js bundle's source map",
  "homepage": "https://github.com/microsoft/rnx-kit/tree/main/packages/third-party-notices#readme",
  "license": "MIT",
  "author": {
    "name": "Microsoft Open Source",
    "email": "microsoftopensource@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/rnx-kit",
    "directory": "packages/third-party-notices"
  },
  "bin": {
    "build-tpn": "./lib/build-tpn.js"
  },
  "files": [
    "bin",
    "lib/**/*.d.ts",
    "lib/**/*.js"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "typescript": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rnx-kit-scripts build",
    "format": "rnx-kit-scripts format",
    "lint": "rnx-kit-scripts lint",
    "test": "rnx-kit-scripts test"
  },
  "dependencies": {
    "@rnx-kit/console": "workspace:^",
    "@rnx-kit/tools-node": "workspace:^",
    "spdx-expression-parse": "^4.0.0",
    "yargs": "catalog:"
  },
  "devDependencies": {
    "@react-native-community/cli-types": "catalog:",
    "@rnx-kit/metro-serializer": "workspace:*",
    "@rnx-kit/scripts": "workspace:*",
    "@rnx-kit/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/yargs": "catalog:",
    "metro-source-map": "catalog:"
  },
  "engines": {
    "node": ">=20.18"
  }
}
